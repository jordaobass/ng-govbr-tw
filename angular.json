{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-govbr-tw": {
      "projectType": "library",
      "root": "projects/ng-govbr-tw",
      "sourceRoot": "projects/ng-govbr-tw/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ng-govbr-tw/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-govbr-tw/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-govbr-tw/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ng-govbr-tw/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "eslintConfig": "projects/ng-govbr-tw/eslint.config.js",
            "lintFilePatterns": [
              "projects/ng-govbr-tw/**/*.ts",
              "projects/ng-govbr-tw/**/*.html"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "compodoc": false,
            "port": 6006,
            "styles": [
              ".storybook/styles.css"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "compodoc": false,
            "outputDir": "dist/storybook",
            "styles": [
              ".storybook/styles.css"
            ]
          }
        }
      }
    }
  }
}
