{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "schematics",
    "lib": ["ES2020"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../../dist/ng-govbr-tw/schematics",
    "declaration": true,
    "target": "ES2020",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["schematics/**/*.ts"],
  "exclude": ["schematics/**/*.spec.ts"]
}
